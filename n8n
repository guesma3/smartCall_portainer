version: '3'

services:
  n8n:
    image: docker.n8n.io/n8nio/n8n
    container_name: n8n
    ports:
      - "5678:5678"
    restart: unless-stopped
    extra_hosts:
      - "host.docker.internal:host-gateway"
    volumes:
      - n8n_data:/home/node/.n8n
    environment:
      # Timezone
      - GENERIC_TIMEZONE=Africa/Casablanca
      - TZ=Africa/Casablanca

      # Security & URLs
      - N8N_SECURE_COOKIE=false
      - EDITOR_BASE_URL=https://c0001n8n.nettronic.uk/
      - WEBHOOK_URL=https://c0001n8n.nettronic.uk/

      # Performance & memory
      - N8N_DEFAULT_BINARY_DATA_MODE=filesystem
      - N8N_RUNNERS_ENABLED=false          # ⚠️ Disable runners to save RAM (they spawn extra Node.js processes)
      - N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS=true

      # Database (SQLite is fine for low load)
      - DB_TYPE=sqlite
      - DB_SQLITE_POOL_SIZE=1              # Keep minimal

      # Execution & pruning (reduce disk & memory pressure)
      - N8N_EXECUTIONS_MODE=regular        # ⚠️ Use "regular" instead of "queue" to avoid Redis dependency
      - EXECUTIONS_PRUNING_ENABLED=true
      - EXECUTIONS_DATA_MAX_AGE=48         # hours
      - EXECUTIONS_DATA_PRUNE=true
      - EXECUTIONS_DATA_SAVE_ON_ERROR=none # Only save if needed
      - EXECUTIONS_DATA_SAVE_ON_SUCCESS=none
      - EXECUTIONS_DATA_SAVE_MANUAL=none

      # Optional: limit concurrency
      - N8N_CONCURRENCY_PRODUCTION=2       # Max 2 workflows at once

    networks:
      - portainer_network

    # ⚠️ Critical: Limit memory to avoid OOM on 2GB Pi
    mem_limit: 600m
    mem_reservation: 300m

    logging:
      driver: "json-file"
      options:
        max-size: "3m"
        max-file: "3"
        compress: "true"

volumes:
  n8n_data:

networks:
  portainer_network:
    external: true
